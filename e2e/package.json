{
  "name": "eo-analyst-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E / UI-quality suite for the EO-Analyst web console, run against the live app + real backend at http://127.0.0.1:8765.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
