POSTGRES_USER=eoa
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=eoanalyst
OLLAMA_URL=http://host.docker.internal:11434
NTFY_URL=http://ntfy:80
NTFY_TOPIC=eo-analyst
TZ=Asia/Jerusalem

# Required by the `searxng` service (docker-compose.yml) — generate a real
# value locally, e.g.: openssl rand -hex 32. Never commit the real value.
SEARXNG_SECRET=change-me-local-only

# U8-ו (docs/adr/005-cloud-llm-cli.md, Revision 2026-09-06) — direct-API cloud LLM providers.
# Optional: only needed for `llm_providers.chains` entries with provider: anthropic/gemini/openai
# (config/config.yaml). Never put a real key anywhere else (not in config.yaml, not in the UI —
# the Settings "מודלים" card only ever shows "מוגדר / לא מוגדר" per key, never the value itself).
# Leave unset to keep those providers unavailable; the fallback chain skips straight past them.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# A8 (docs/adr/006-mcp-sources.md) — MCP (Model Context Protocol) tool sources for the
# interactive analyst. All optional; a missing key degrades only that tool to a graceful
# "not_configured" response, never a crash. Never logged, never sent to the UI beyond a
# "מוגדר / לא מוגדר" boolean (config/mcp.yaml's `env` lists these names, never values).

# eoa.mcp_servers.procurement — SAM.gov Opportunities API (free, self-serve at sam.gov) and
# Congress.gov API (free, self-serve at api.congress.gov). USAspending, Federal Register, and
# DSCA need no key at all.
SAM_GOV_API_KEY=
CONGRESS_GOV_API_KEY=

# eoa.mcp_servers.janes — the user's own Janes Data Services subscription. JANES_API_BASE
# defaults to https://developer.janes.com/api if unset; override if your subscription uses a
# different base URL (see agent/eoa/mcp_servers/janes.py's "verify against your subscription's
# API docs" note).
JANES_API_KEY=
JANES_API_BASE=

# eoa.mcp_servers.patents — EPO Open Patent Services (OAuth2 client-credentials app, free
# registration at developers.epo.org: My Apps -> Add a new app -> Consumer Key/Secret; a
# non-paying account covers US publications too via Espacenet's worldwide data).
# USPTO Open Data Portal (ODP) Patent File Wrapper API -- the US patent source since 2026-09-07
# (https://data.uspto.gov/apis/getting-started): one key per USPTO.gov account, which must be
# linked to an ID.me-verified identity (video-call verification for non-US users); the key is
# shown on the ODP "Manage API Key" page, is deleted after 90 days unused, and is sent as the
# X-API-KEY header. Limits: 5M metadata calls/week, ONE call in flight per key (429 otherwise).
# USPTO PatentsView was shut down in the March-2026 ODP migration (its host no longer resolves
# and its keys are not valid for ODP): PATENTSVIEW_API_KEY/PATENTSVIEW_API_BASE are accepted but
# ignored (one deprecation warning per process) -- delete them from .env.
EPO_OPS_KEY=
EPO_OPS_SECRET=
USPTO_ODP_API_KEY=
