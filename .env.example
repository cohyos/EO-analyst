POSTGRES_USER=eoa
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=eoanalyst
OLLAMA_URL=http://host.docker.internal:11434
NTFY_URL=http://ntfy:80
NTFY_TOPIC=eo-analyst
TZ=Asia/Jerusalem

# Required by the `searxng` service (docker-compose.yml) — generate a real
# value locally, e.g.: openssl rand -hex 32. Never commit the real value.
SEARXNG_SECRET=change-me-local-only

# U8-ו (docs/adr/005-cloud-llm-cli.md, Revision 2026-09-06) — direct-API cloud LLM providers.
# Optional: only needed for `llm_providers.chains` entries with provider: anthropic/gemini/openai
# (config/config.yaml). Never put a real key anywhere else (not in config.yaml, not in the UI —
# the Settings "מודלים" card only ever shows "מוגדר / לא מוגדר" per key, never the value itself).
# Leave unset to keep those providers unavailable; the fallback chain skips straight past them.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
